@startuml UC_Diagrama
left to right direction
skinparam packageStyle rectangle

actor Coordenador
actor Tutor
actor Tutorando
actor "Diretor de Curso" as Diretor

rectangle "Sistema de Tutorias UTC-INF" {
  package "Acesso e Notificações" {
    usecase "UC01 Autenticar" as UC01
    usecase "UC04 Enviar notificação" as UC04
  }
  package "Gestão de Alunos e Atribuições" {
    usecase "UC02 Registar aluno" as UC02
    usecase "UC03 Associar aluno a tutor" as UC03
  }
  package "Dados do Tutorando" {
    usecase "UC05 Registar-se no sistema" as UC05
    usecase "UC06 Preencher dados pessoais\ne proveniência" as UC06
    usecase "UC07 Preencher ficha de frequência" as UC07
    usecase "UC09 Consultar/alterar dados\ndo tutorando" as UC09
  }
  package "Reuniões" {
    usecase "UC08 Solicitar reunião" as UC08
    usecase "UC10 Convocar reunião" as UC10
    usecase "UC11 Registar reunião" as UC11
  }
  package "Relatórios" {
    usecase "UC12 Consultar estatísticas\nde aproveitamento por UC" as UC12
    usecase "UC13 Consultar relatório\nde atividade de tutoria" as UC13
  }
}

Coordenador --> UC02
Coordenador --> UC03
Tutorando --> UC05
Tutorando --> UC06
Tutorando --> UC07
Tutorando --> UC08
Tutor --> UC09
Tutor --> UC10
Tutor --> UC11
Diretor --> UC12
Diretor --> UC13

UC02 .down.> UC03 : <<include>>
UC03 .down.> UC04 : <<include>>
UC07 .down.> UC04 : <<include>>
UC08 .down.> UC04 : <<include>>

UC02 .up.> UC01 : <<include>>
UC06 .up.> UC01 : <<include>>
UC07 .up.> UC01 : <<include>>
UC08 .up.> UC01 : <<include>>
UC09 .up.> UC01 : <<include>>
UC10 .up.> UC01 : <<include>>
UC11 .up.> UC01 : <<include>>
UC12 .up.> UC01 : <<include>>
UC13 .up.> UC01 : <<include>>

note bottom of UC05
  Único caso de uso que não exige
  autenticação prévia (o aluno
  ainda não tem conta).
end note
@enduml

@startuml Modelo_Dominio
skinparam classAttributeIconSize 0
hide empty members
legend right
  **Negrito** = atributo/operação novo ou alterado
  pela análise de robustez
endlegend

class Utilizador {
  nome
  morada
  email
  telefone
  **dataNascimento**
  username
  password
  **estadoConta**
  --
  **autenticar()**
  **criarConta()**
}
class Coordenador {
  numeroFuncionario
}
class Tutor {
  numeroDocente
  gabinete
  --
  **obterTutorandos()**
}
class Tutorando {
  numeroAluno
  anoIngresso
  justificacaoCurso
  **dataAtribuicao**
  --
  **registar()**
  **alterarDados()**
  **associarTutor()**
}
class Proveniencia {
  instituicaoAnterior
  areaFormacao
}
class Curso {
  nome
  grau
}
class UnidadeCurricular {
  nome
  ano
  semestre
  ects
}
class FichaFrequencia {
  dataPreenchimento
  --
  **guardar()**
}
class RegistoUC {
  comentarioAulas
  **anoLetivo**
}
class Avaliacao {
  epoca
  nota
}
class Reuniao {
  **dataPedido**
  **assuntoPedido**
  **datasSugeridas**
  data
  hora
  local
  **estado**
  assuntosTratados
  --
  **solicitar()**
  **convocar()**
  **registar()**
}
class Mensagem {
  data
  tipo
  texto
  **estadoEnvio**
  --
  **enviar()**
}

Utilizador <|-- Coordenador
Utilizador <|-- Tutor
Utilizador <|-- Tutorando

Tutor "1" -- "0..*" Tutorando : tutoria
Coordenador "1" -- "0..*" Tutorando : atribui
Tutorando "1" *-- "1" Proveniencia
Tutorando "0..*" -- "1" Curso : frequenta
Curso "1" o-- "1..*" UnidadeCurricular
Tutorando "1" -- "0..*" FichaFrequencia : preenche
FichaFrequencia "1" *-- "1..*" RegistoUC
RegistoUC "0..*" -- "1" UnidadeCurricular : refere-se a
RegistoUC "1" *-- "0..*" Avaliacao
Reuniao "0..*" -- "1" Tutor : convoca/regista
Reuniao "0..*" -- "1" Tutorando : diz respeito a
Reuniao "0..*" -- "1..*" Utilizador : presentes
Reuniao "0..*" -- "1" Utilizador : solicitadaPor
Mensagem "0..*" -- "1" Utilizador : destinatário

note bottom of Reuniao
  estado: pendente | convocada | realizada
end note
note bottom of Mensagem
  estadoEnvio: enviada | pendente
end note
note bottom of Utilizador
  estadoConta: sem conta | ativa
end note
@enduml

@startuml UC01_Robustez
left to right direction
actor Utilizador
boundary formLogin
control verificarCredenciais
entity "utilizador" as entUtilizador
boundary pagMenuPrincipal
boundary janMensagemErro

Utilizador --> formLogin : introduz credenciais
formLogin --> verificarCredenciais : submeter login
verificarCredenciais <-- entUtilizador : consultar
verificarCredenciais --> pagMenuPrincipal : [sucesso]
pagMenuPrincipal --> Utilizador : apresenta menu
verificarCredenciais --> janMensagemErro : [erro]
janMensagemErro --> Utilizador : informa erro
@enduml

@startuml UC02_Robustez
left to right direction
actor Coordenador
boundary formRegistoAluno
control registarAluno
entity "aluno" as entAluno
entity "curso" as entCurso
boundary janConfirmacao
boundary janMensagemErro

Coordenador --> formRegistoAluno : regista aluno
formRegistoAluno --> registarAluno : submeter dados
registarAluno <--> entAluno : criarAluno
registarAluno <-- entCurso : obterCursos
registarAluno --> janConfirmacao : [sucesso]
janConfirmacao --> Coordenador : confirma registo
registarAluno --> janMensagemErro : [erro]
janMensagemErro --> Coordenador : informa erro
@enduml

@startuml UC03_Robustez
left to right direction
actor Coordenador
actor Tutor
actor Tutorando
boundary formAtribuicao
control atribuirTutor
entity "aluno" as entAluno
entity "tutor" as entTutor
control enviarNotificacao
entity "mensagem" as entMensagem
boundary janNotificacaoTutor
boundary janNotificacaoTutorando

Coordenador <--> formAtribuicao : atribui tutor
formAtribuicao <--> atribuirTutor : escolher tutor
atribuirTutor <--> entAluno : associarTutor
atribuirTutor <-- entTutor : obterTutor
atribuirTutor --> enviarNotificacao : notificar
enviarNotificacao <--> entMensagem : registarMensagem
enviarNotificacao --> janNotificacaoTutor : mensagem ao tutor
janNotificacaoTutor --> Tutor
enviarNotificacao --> janNotificacaoTutorando : mensagem ao tutorando
janNotificacaoTutorando --> Tutorando
@enduml

@startuml UC04_Robustez
left to right direction
actor Tutor
actor Tutorando
control enviarNotificacao
entity "mensagem" as entMensagem
entity "utilizador" as entUtilizador
boundary janNotificacaoTutor
boundary janNotificacaoTutorando

note top of enviarNotificacao : invocado por UC03, UC07 e UC08

enviarNotificacao <--> entMensagem : registarMensagem
enviarNotificacao <-- entUtilizador : obterEmail
enviarNotificacao --> janNotificacaoTutor : mensagem ao tutor
janNotificacaoTutor --> Tutor
enviarNotificacao --> janNotificacaoTutorando : mensagem ao tutorando
janNotificacaoTutorando --> Tutorando
@enduml

@startuml UC05_Robustez
left to right direction
actor Tutorando
boundary formRegisto
control registarConta
entity "aluno" as entAluno
entity "utilizador" as entUtilizador
boundary janConfirmacao
boundary janMensagemErro

Tutorando --> formRegisto : regista-se
formRegisto --> registarConta : submeter dados
registarConta <-- entAluno : obterAluno
registarConta <--> entUtilizador : criarConta
registarConta --> janConfirmacao : [sucesso]
janConfirmacao --> Tutorando : confirma
registarConta --> janMensagemErro : [erro]
janMensagemErro --> Tutorando : informa erro
@enduml

@startuml UC06_Robustez
left to right direction
actor Tutorando
boundary formDadosPessoais
control gravarDadosTutorando
entity "tutorando" as entTutorando
entity "proveniencia" as entProveniencia
boundary janConfirmacao
boundary janMensagemErro

Tutorando <--> formDadosPessoais : preenche dados
formDadosPessoais <--> gravarDadosTutorando : submeter dados
gravarDadosTutorando <--> entTutorando : gravarDados
gravarDadosTutorando <--> entProveniencia : gravarProveniencia
gravarDadosTutorando --> janConfirmacao : [sucesso]
janConfirmacao --> Tutorando : confirma
gravarDadosTutorando --> janMensagemErro : [erro]
janMensagemErro --> Tutorando : informa erro
@enduml

@startuml UC07_Robustez
left to right direction
actor Tutorando
actor Tutor
boundary formFichaFrequencia
control obterUCs
control guardarFicha
control notificarTutor
entity "unidadeCurricular" as entUC
entity "fichaFrequencia" as entFicha
entity "avaliacao" as entAvaliacao
entity "mensagem" as entMensagem
boundary janNotificacaoTutor
boundary janMensagemErro

Tutorando <--> formFichaFrequencia : preenche ficha
formFichaFrequencia <--> obterUCs : listar UCs
obterUCs <-- entUC : consultar
formFichaFrequencia --> guardarFicha : submeter notas
guardarFicha <--> entFicha : gravar ficha
guardarFicha <--> entAvaliacao : gravar notas
guardarFicha --> notificarTutor : [comentário]
notificarTutor <--> entMensagem : registarMensagem
notificarTutor --> janNotificacaoTutor : avisa tutor
janNotificacaoTutor --> Tutor
guardarFicha --> janMensagemErro : [erro]
janMensagemErro --> Tutorando : informa erro
@enduml

@startuml UC08_Robustez
left to right direction
actor Tutorando
actor Tutor
boundary formPedidoReuniao
control registarPedido
control enviarNotificacao
entity "reuniao" as entReuniao
entity "tutorando" as entTutorando
entity "mensagem" as entMensagem
boundary janNotificacaoTutor
boundary janMensagemErro

Tutorando <--> formPedidoReuniao : solicita reunião
formPedidoReuniao <--> registarPedido : submeter pedido
registarPedido <--> entReuniao : criarPedido
registarPedido <-- entTutorando : obterTutor
registarPedido --> enviarNotificacao : notificar tutor
enviarNotificacao <--> entMensagem : registarMensagem
enviarNotificacao --> janNotificacaoTutor : avisa tutor
janNotificacaoTutor --> Tutor
registarPedido --> janMensagemErro : [erro]
janMensagemErro --> Tutorando : informa erro
@enduml

@startuml UC09_Robustez
left to right direction
actor Tutor
boundary pagListaTutorandos
boundary pagDadosTutorando
boundary opcaoAlterar
boundary formAlteracaoDados
control obterDadosTutorando
control verificarDados
entity "tutorando" as entTutorando
entity "proveniencia" as entProveniencia
entity "fichaFrequencia" as entFicha
boundary janMensagemErro

Tutor --> pagListaTutorandos : escolhe tutorando
pagListaTutorandos --> obterDadosTutorando : pedir dados
obterDadosTutorando <-- entTutorando : consultar
obterDadosTutorando <-- entProveniencia : consultar
obterDadosTutorando <-- entFicha : consultar
obterDadosTutorando --> pagDadosTutorando : apresentar
pagDadosTutorando --> Tutor
pagDadosTutorando o-- opcaoAlterar
opcaoAlterar --> obterDadosTutorando : pré-preencher
obterDadosTutorando --> formAlteracaoDados
Tutor <--> formAlteracaoDados : altera dados
formAlteracaoDados --> verificarDados : submeter
verificarDados --> entTutorando : [dados ok] atualizar
verificarDados --> entProveniencia : [dados ok] atualizar
verificarDados --> janMensagemErro : [erro]
janMensagemErro --> Tutor : informa erro
@enduml

@startuml UC10_Robustez
left to right direction
actor Tutor
boundary formConvocarReuniao
control convocarReuniao
entity "reuniao" as entReuniao
entity "tutorando" as entTutorando
boundary janConfirmacao
boundary janMensagemErro

Tutor <--> formConvocarReuniao : convoca reunião
formConvocarReuniao --> convocarReuniao : submeter dados
convocarReuniao <--> entReuniao : criarReuniao
convocarReuniao <-- entTutorando : obterTutorandos
convocarReuniao --> janConfirmacao : [sucesso]
janConfirmacao --> Tutor : confirma
convocarReuniao --> janMensagemErro : [erro]
janMensagemErro --> Tutor : informa erro
@enduml

@startuml UC11_Robustez
left to right direction
actor Tutor
boundary formRegistoReuniao
control registarReuniao
entity "reuniao" as entReuniao
entity "utilizador" as entUtilizador
boundary janConfirmacao
boundary janMensagemErro

Tutor <--> formRegistoReuniao : regista reunião
formRegistoReuniao --> registarReuniao : submeter dados
registarReuniao <--> entReuniao : atualizarReuniao
registarReuniao <-- entUtilizador : obterPresentes
registarReuniao --> janConfirmacao : [sucesso]
janConfirmacao --> Tutor : confirma
registarReuniao --> janMensagemErro : [erro]
janMensagemErro --> Tutor : informa erro
@enduml

@startuml UC12_Robustez
left to right direction
actor "Diretor de Curso" as Diretor
boundary formFiltrosEstatisticas
control calcularEstatisticas
entity "unidadeCurricular" as entUC
entity "registoUC" as entRegisto
entity "avaliacao" as entAvaliacao
boundary pagEstatisticas
boundary janMensagemErro

Diretor --> formFiltrosEstatisticas : escolhe filtros
formFiltrosEstatisticas --> calcularEstatisticas : submeter filtros
calcularEstatisticas <-- entUC : obterUCs
calcularEstatisticas <-- entRegisto : obterRegistos
calcularEstatisticas <-- entAvaliacao : obterNotas
calcularEstatisticas --> pagEstatisticas : [resultado]
pagEstatisticas --> Diretor : apresenta
calcularEstatisticas --> janMensagemErro : [sem dados / erro]
janMensagemErro --> Diretor : informa
@enduml

@startuml UC13_Robustez
left to right direction
actor "Diretor de Curso" as Diretor
boundary formFiltrosRelatorio
control gerarRelatorio
entity "tutor" as entTutor
entity "tutorando" as entTutorando
entity "reuniao" as entReuniao
boundary pagRelatorioTutoria
boundary janMensagemErro

Diretor --> formFiltrosRelatorio : escolhe filtros
formFiltrosRelatorio --> gerarRelatorio : submeter filtros
gerarRelatorio <-- entTutor : obterTutores
gerarRelatorio <-- entTutorando : obterTutorandos
gerarRelatorio <-- entReuniao : obterReunioes
gerarRelatorio --> pagRelatorioTutoria : [resultado]
pagRelatorioTutoria --> Diretor : apresenta
gerarRelatorio --> janMensagemErro : [sem dados / erro]
janMensagemErro --> Diretor : informa
@enduml
